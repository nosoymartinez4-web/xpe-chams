{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "api/*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/api/index.html" },
    { "src": "/api", "dest": "/api/index.html" },
    { "src": "/api/", "dest": "/api/index.html" },
    { "src": "/api/auth", "dest": "/api/auth.js" },
    { "src": "/api/verify", "dest": "/api/verify.js" },
    { "src": "/api/check", "dest": "/api/check.js" },
    { "src": "/api/admin", "dest": "/api/admin.js" },
    { "src": "/api/seller", "dest": "/api/seller.js" },
    { "src": "/api/generate", "dest": "/api/generate.js" },
    { "src": "/api/revoke", "dest": "/api/revoke.js" },
    { "src": "/manifest.json", "dest": "/api/manifest.json" },
    { "src": "/sw.js", "dest": "/api/sw.js" },
    { "src": "/(.*)", "dest": "/api/$1" }
  ]
}